# Copy to .env for local runs (the app does not load .env itself: `set -a; . ./.env; set +a`).
# On Render, add each of these under Environment -> Environment Variables.

# --- Required -------------------------------------------------------------
GEMINI_API_KEY=your-key-from-aistudio.google.com

# --- Who the bot answers ---------------------------------------------------
# whitelist = only the numbers in WHITELIST.   all = every 1:1 chat except BLOCKLIST.
# Group chats are NEVER answered in either mode.
REPLY_MODE=whitelist
# International format, digits only, no "+" (NOT 0701..., use 256701...). Comma separated.
WHITELIST=256701234567,256772345678
# Never answered, in any mode (boss, bank, ex, official numbers...).
BLOCKLIST=
# In "all" mode: only answer people who exist in knowledge/contacts.json (ignores strangers).
ONLY_KNOWN_CONTACTS=false

# --- Required on Render's free tier (keeps the QR login across restarts) ----
# A Postgres connection string, e.g. from Neon or Supabase. Use the DIRECT (non-pooled)
# connection string.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Safety nets (all optional) ---------------------------------------------------
MIN_DELAY_SECONDS=5
MAX_DELAY_SECONDS=15
MAX_REPLIES_PER_HOUR=30        # per contact
HANDOFF_MINUTES=60             # bot stays out of a chat this long after YOU reply by hand (0 = off)
MAX_MESSAGE_AGE_SECONDS=900    # ignore messages older than this (e.g. delivered after a restart)
NOTIFY_NUMBER=                 # YOUR OWN number: you get a WhatsApp note when the bot skips a message
TIMEZONE=Africa/Kampala        # so the bot knows today's date/time

# --- Apologies (see README section 2b) -------------------------------------------
# off   = never says sorry for you (stays silent and notifies you)
# light = short general sorry for small slips only (slow/dry replies, missed call)   <- default
# full  = also a sincere sorry to people who are properly upset (serious stuff still goes to you)
# A person's own "apology" value in contacts.json beats this.
APOLOGY_MODE=light
APOLOGY_NOTIFY=true            # needs NOTIFY_NUMBER: you get a note each time the bot said sorry

# --- Other options ---------------------------------------------------------------
# Google retires models; see https://ai.google.dev/gemini-api/docs/models for the current Flash ones.
GEMINI_MODEL=gemini-2.5-flash
MAX_HISTORY_MESSAGES=12
SPLIT_MESSAGES=true
MAX_BUBBLES=3
PAGE_KEY=choose-a-long-random-string   # if set, QR only shows on /?key=THIS
GEMINI_MAX_RETRIES=5
GEMINI_MAX_WAIT_SECONDS=75
QR_STALE_SECONDS=180
RECONNECT_GRACE_SECONDS=300
LOG_LEVEL=INFO
# KNOWLEDGE_DIR=knowledge      # where profile.md / contacts.json / examples.json / style.md live
# SECRETS_DIR=/etc/secrets     # Render Secret Files are read from here as a fallback
# SQLITE_PATH=session.db       # only used when DATABASE_URL is empty (local testing)
